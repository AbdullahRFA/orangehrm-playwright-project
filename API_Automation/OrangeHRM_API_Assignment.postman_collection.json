{
  "info": {
    "_postman_id": "3a0b1d20-7d16-45d4-8e0c-123456789abc",
    "name": "OrangeHRM API Assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "item": [
    {
      "name": "1. GET All Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const users = pm.response.json();",
              "",
              "pm.test('Response contains user data', function () {",
              "    pm.expect(users.length).to.be.above(0);",
              "});",
              "",
              "pm.test('Each user has id, name and email', function () {",
              "    users.forEach(user => {",
              "        pm.expect(user).to.have.property('id');",
              "        pm.expect(user).to.have.property('name');",
              "        pm.expect(user).to.have.property('email');",
              "    });",
              "});",
              "",
              "const selectedUser = users[0];",
              "pm.collectionVariables.set('userId', selectedUser.id);",
              "",
              "const random = Date.now();",
              "",
              "pm.collectionVariables.set('dynamicName', 'QA User ' + random);",
              "pm.collectionVariables.set('dynamicEmail', 'qa' + random + '@example.com');",
              "pm.collectionVariables.set('dynamicCompany', 'QA Company ' + random);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
    {
      "name": "2. PUT Update User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const res = pm.response.json();",
              "",
              "pm.test('Returned id matches stored userId', function () {",
              "    pm.expect(Number(res.id)).to.eql(Number(pm.collectionVariables.get('userId')));",
              "});",
              "",
              "pm.test('Updated name is returned', function () {",
              "    pm.expect(res.name).to.eql(pm.collectionVariables.get('dynamicName'));",
              "});",
              "",
              "pm.test('Updated email is returned', function () {",
              "    pm.expect(res.email).to.eql(pm.collectionVariables.get('dynamicEmail'));",
              "});",
              "",
              "pm.test('Company name is updated', function () {",
              "    pm.expect(res.company.name).to.eql(pm.collectionVariables.get('dynamicCompany'));",
              "});",
              "",
              "pm.test('Phone field is not empty', function () {",
              "    pm.expect(res.phone).to.not.be.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{userId}},\n  \"name\": \"{{dynamicName}}\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"phone\": \"123-456-7890\",\n  \"company\": {\n    \"name\": \"{{dynamicCompany}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      }
    }
  ]
}